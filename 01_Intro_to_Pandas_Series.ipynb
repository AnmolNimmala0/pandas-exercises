import pandas as pd 
b. 
#creating a series without custom index
  d = [1,2,3,4]
  s=pd.Series(d)
  print(s)
  #creating a series with custom indexing
  d=[1,2,3,4]
  print(pd.Series(d,index=['a','b','c','d']))
  #creating aa series from a dictonary
  d={'name':['ANMOL','PALAK','MAXY'],
      'age':[20,21,22]}
  s=pd.Series(d)
  print(s)
