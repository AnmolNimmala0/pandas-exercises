#identify missing values using isnull() and notnull()
import pandas as pd
import numpy as np

data = {
    'Name': ['Anmol', 'Palak', 'Maxy', 'Zoya'],
    'Age': [20, np.nan, 22, 23],
    'Score': [88, 92, np.nan, 75]
}
df = pd.DataFrame(data)

print(df.isnull())  
print(df.notnull())
#Handling missing data using fillna() and dropna()
1. df.fillna(0)
df.dropna()
df['Age'].fillna(df['Age'].mean())
