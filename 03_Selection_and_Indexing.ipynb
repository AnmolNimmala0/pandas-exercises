#using iloc[] and loc[]
data = {
    'Name': ['Anmol', 'Palak', 'Maxy'],
    'Age': [20, 21, 22],
    'Score': [88, 92, 75]
}
df = pd.DataFrame(data)

print(df.loc[0:2,['Name','Age']])#1to3row and name and age columns
print(df.iloc[0:2,0:2])#rows from 0 to 3 and columns also from 0 to 3 
print(df.iloc[0,2])#row 0 and column 3 
#selecting rows ad columns using slicing
print(df['Age'])
print(df[0:2])
# to set and reset indexes
df.set_index(['Name'],inplace=True)
df.reset_index(inplace=True)
#conditionals
print(df[(df['Age'] > 20) & (df['Score'] > 80)]) 
print(df[(df['Age']>20)])
#chnaging nmae of index and columns
df.index.name='Name of index'
df.columns.name='Name of colums'
print(df)
