#concat data vertically and horizontally 
df1 = pd.DataFrame({
    'ID': [1, 2, 3],
    'Name': ['Anmol', 'Palak', 'Maxy']
})

df2 = pd.DataFrame({
    'ID': [4, 5],
    'Name': ['Zoya', 'Krit']
})

print(pd.concat([df1,df2],ignore_index=True,axis=1))#horizontal
print(pd.concat([df1,df2],ignore_index=True,a))#vertical

#merge two datas
df_scores = pd.DataFrame({
    'ID': [1, 2, 3],
    'Score': [88, 92, 75]
})

print(pd.merge(df1,df_scores,on='ID'))

#join two data
print(pd.merge(df1,df_scores,on='ID',how='outer'))#outer
print(pd.merge(df1,df_scores,on='ID',how='inner'))#inner
